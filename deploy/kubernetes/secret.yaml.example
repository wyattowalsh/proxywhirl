# Copy to secret.yaml (gitignored) and apply with real values, or create via your secret manager / SealedSecrets.
# Never commit secret.yaml with production credentials.
#
# Generate keys:
#   openssl rand -base64 32   # api-key
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  # cache-encryption-key
#
# Redis URL must include the password when Redis requires auth:
#   redis://:PASSWORD@redis:6379/0
apiVersion: v1
kind: Secret
metadata:
  name: proxywhirl-secrets
  namespace: proxywhirl
type: Opaque
stringData:
  cache-encryption-key: "REPLACE_WITH_fernet_key"
  api-key: "REPLACE_WITH_openssl_rand_base64_32"
  redis-password: "REPLACE_WITH_strong_redis_password"
  redis-url: "redis://:REPLACE_WITH_strong_redis_password@redis:6379/0"
