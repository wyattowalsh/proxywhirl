[Unit]
Description=ProxyWhirl Proxy Rotation Service
After=network.target
Documentation=https://www.proxywhirl.com/docs/guides/deployment

[Service]
Type=simple
User=proxywhirl
Group=proxywhirl
WorkingDirectory=/opt/proxywhirl

ExecStart=/opt/proxywhirl/.venv/bin/uvicorn proxywhirl.api:app --host ${PROXYWHIRL_BIND_HOST} --port 8000
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment
Environment="PROXYWHIRL_BIND_HOST=0.0.0.0"
EnvironmentFile=-/etc/default/proxywhirl
Environment="PATH=/opt/proxywhirl/.venv/bin"
Environment="PYTHONUNBUFFERED=1"

# Resource limits
LimitNOFILE=65536
LimitNPROC=65536

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/proxywhirl /var/log/proxywhirl

[Install]
WantedBy=multi-user.target
