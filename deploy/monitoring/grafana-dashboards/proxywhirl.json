{
  "title": "ProxyWhirl Metrics",
  "tags": ["proxywhirl"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "panels": [
      {
        "title": "Healthy Proxies",
        "targets": [
          {
            "datasource": {"type": "prometheus", "uid": "prometheus"},
            "expr": "proxywhirl_proxies_healthy"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Error Rate",
        "targets": [
          {
            "datasource": {"type": "prometheus", "uid": "prometheus"},
            "expr": "sum(rate(proxywhirl_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(proxywhirl_requests_total[5m])), 1)"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Request Latency (P95)",
        "targets": [
          {
            "datasource": {"type": "prometheus", "uid": "prometheus"},
            "expr": "histogram_quantile(0.95, sum(rate(proxywhirl_request_duration_seconds_bucket[5m])) by (le))"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Total Proxies",
        "targets": [
          {
            "datasource": {"type": "prometheus", "uid": "prometheus"},
            "expr": "proxywhirl_proxies_total"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Open Circuit Breakers",
        "targets": [
          {
            "datasource": {"type": "prometheus", "uid": "prometheus"},
            "expr": "sum(proxywhirl_circuit_breaker_state == 1)"
          }
        ],
        "type": "graph"
      },
      {
        "title": "HTTP Request Rate",
        "targets": [
          {
            "datasource": {"type": "prometheus", "uid": "prometheus"},
            "expr": "sum(rate(proxywhirl_requests_total[5m]))"
          }
        ],
        "type": "graph"
      }
  ]
}
